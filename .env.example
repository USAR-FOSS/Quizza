# Postgres connection string. Local docker, Neon, Supabase - anything works.
# Local example: postgres://postgres:postgres@localhost:5432/quizza
DATABASE_URL="postgres://postgres:postgres@localhost:5432/quizza"

# Secret used to sign host session cookies. Use a long random string in prod.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Host sign-in via FOSSClub OIDC (optional) ---
# Leave CLIENT_ID/SECRET empty to disable the FOSSClub button; email/password
# sign-in still works. Credentials are issued manually by the provider admins.
OIDC_ISSUER="https://oidc.fossclub.tech"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
