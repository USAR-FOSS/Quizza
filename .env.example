# Postgres connection string. Local docker, Neon, Supabase - anything works.
# Local example: postgres://postgres:postgres@localhost:5432/quizza
DATABASE_URL="postgres://postgres:postgres@localhost:5432/quizza"

# Secret used to sign host session cookies. Use a long random string in prod.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Host sign-in via FOSSClub OIDC (optional) ---
# Leave CLIENT_ID/SECRET empty to disable the FOSSClub button; email/password
# sign-in still works. Credentials are issued manually by the provider admins.
OIDC_ISSUER="https://oidc.fossclub.tech"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# --- Shared realtime infrastructure ---
# Standard Redis URL. Pub/Sub needs a persistent protocol connection; do not
# substitute an HTTP-only Redis REST URL here.
REDIS_URL="redis://localhost:6379"
# `memory` is convenient for local UI work. Production must use `redis`.
REALTIME_DRIVER="memory"
# Canonical public origin used by QStash to call the reveal callback.
APP_URL="http://localhost:3000"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
INTERNAL_HEALTH_SECRET=""
# Keep serverless Postgres pools small; use a pooled DATABASE_URL on Vercel.
DB_POOL_MAX="2"
